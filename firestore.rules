rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas existentes de las otras aplicaciones QUIRU.
    match /{document=**} {
      allow read;
      allow write: if request.auth != null;
    }

    match /marketing/{document=**} {
      allow read;
      allow write;
    }

    // Formulario público de contacto de QUIRU Labs.
    match /quirulabs_consultas/{consultaId} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'nombre', 'empresa', 'email', 'telefono',
          'servicioInteres', 'mensaje', 'estado', 'origen', 'creadoEn'
        ]) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() >= 2 &&
        request.resource.data.nombre.size() <= 120 &&
        request.resource.data.empresa is string &&
        request.resource.data.empresa.size() <= 160 &&
        request.resource.data.email is string &&
        request.resource.data.email.size() <= 160 &&
        request.resource.data.telefono is string &&
        request.resource.data.telefono.size() <= 60 &&
        request.resource.data.servicioInteres is string &&
        request.resource.data.servicioInteres.size() <= 120 &&
        request.resource.data.mensaje is string &&
        request.resource.data.mensaje.size() >= 10 &&
        request.resource.data.mensaje.size() <= 5000 &&
        request.resource.data.estado == 'nueva' &&
        request.resource.data.origen == 'sitio_web' &&
        request.resource.data.creadoEn is timestamp;

      allow read, update, delete: if false;
    }
  }
}
